---
source: tests/templates.rs
expression: "render(role, strategy)"
---
name: 🚀 Prepare Release

on:
  # Required. gh-ship starts this workflow through the API, which can
  # only start workflows declaring `workflow_dispatch`.
  workflow_dispatch:
    inputs:
      dry_run:
        description: Produce the artifact but do not commit or push
        required: false
        type: boolean
        default: false

  # Optional, but recommended: declaring `workflow_call` as well keeps
  # this workflow reusable from other workflows without giving up the
  # ability for gh-ship to dispatch it.
  workflow_call:
    inputs:
      dry_run:
        required: false
        type: boolean
        default: false

permissions:
  contents: write

jobs:
  prepare:
    runs-on: ubuntu-latest

    # Environment secrets without a deployment record. Preparing a release
    # is not a deployment, and `deployment: false` keeps it out of the
    # repository's deployment history while still granting the secrets:
    # https://docs.github.com/en/actions/how-tos/deploy/configure-and-manage-deployments/control-deployments
    #
    # GitHub creates the environment on first use.
    environment:
      name: release
      deployment: false

    # Every `gh` invocation in this job authenticates with this.
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    steps:
      - uses: actions/checkout@v7
        with:
          # Full history: changelog generators need the tags.
          fetch-depth: 0
          # gh-ship dispatches this workflow on a throwaway staging branch
          # cut from your base branch, so the default checkout is already
          # the right ref. Push to HEAD, never to the release branch.
          #
          # This token cannot trigger other workflows, so the Release PR
          # will show no CI results. To change that, re-run `gh ship init`
          # and pick a GitHub App or a PAT. See:
          # https://noirbizarre.github.io/gh-ship/workflows/#tokens
          token: ${{ secrets.GITHUB_TOKEN }}

      # ----------------------------------------------------------------
      # Everything below is YOURS. gh-ship never bumps versions, writes
      # changelogs, or runs release logic. Replace these steps with
      # whatever your project already uses — cargo-release, Commitizen,
      # git-cliff, semantic-release, Changesets, a shell script.
      # ----------------------------------------------------------------

      - name: Compute the next version
        id: version
        run: |
          # Replace with your own versioning tool.
          echo "version=1.0.0" >> "$GITHUB_OUTPUT"
          echo "changed=true"  >> "$GITHUB_OUTPUT"

      - name: Generate release notes
        if: steps.version.outputs.changed == 'true'
        run: |
          # Replace with your own changelog tool.
          #
          # Write the notes outside the worktree. They are scratch input
          # for `jq --rawfile` below, not a source file, so keeping them
          # in $RUNNER_TEMP is what stops `git add -A` from committing
          # them to the release branch.
          printf '## What'"'"'s Changed\n\n* ...\n' > "$RUNNER_TEMP/ship-notes.md"

      - name: Apply the version and commit
        if: steps.version.outputs.changed == 'true' && !inputs.dry_run
        run: |
          # Replace with your own file updates.
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --quiet || git commit -m "chore(release): ${{ steps.version.outputs.version }}"
          git push origin HEAD

      # ----------------------------------------------------------------
      # The protocol. gh-ship reads exactly this artifact and nothing
      # else. See:
      # https://noirbizarre.github.io/gh-ship/specifications/release-artifact/
      # ----------------------------------------------------------------

      - name: Write the release artifact
        run: |
          if [ "${{ steps.version.outputs.changed }}" != "true" ]; then
            jq -n '{schemaVersion: 1, changed: false}' > ship.release.json
          else
            # The tag convention is entirely yours: gh-ship never derives the
            # tag from the version. `v1.4.0` is the common default; drop the
            # `v` here if your project tags as `1.4.0`.
            jq -n \
              --arg version "${{ steps.version.outputs.version }}" \
              --arg tag     "v${{ steps.version.outputs.version }}" \
              --rawfile notes "$RUNNER_TEMP/ship-notes.md" \
              '{
                "$schema": "https://noirbizarre.github.io/gh-ship/schema/release/v1.json",
                schemaVersion: 1,
                changed: true,
                version: $version,
                tag: $tag,
                release: { notes: $notes }
              }' > ship.release.json
          fi

      # Validating here turns a protocol mistake into a red workflow with
      # a precise error, instead of a confusing failure in gh-ship later.
      # This step needs no network and no repository.
      - name: Validate the release artifact
        run: |
          gh extension install noirbizarre/gh-ship
          gh ship validate ship.release.json

      - uses: actions/upload-artifact@v7
        with:
          name: ship-release
          path: ship.release.json
          if-no-files-found: error
